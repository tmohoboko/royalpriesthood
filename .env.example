# Optional browser-visible enquiry recipient. Never place secrets in VITE_ variables.
VITE_CONTACT_EMAIL=
# Server only; use an isolated preview PostgreSQL database and verified TLS connection.
DATABASE_URL=
# Exact HTTPS origin of this preview; used for CSRF and PayFast callbacks.
APP_ORIGIN=
# Blank disables order creation and payment initiation. This release accepts sandbox only.
PAYFAST_MODE=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Server-only transactional email adapter (verified sender domain required).
RESEND_API_KEY=
EMAIL_FROM=

# Optional dedicated ITN-only alias; Preview + sandbox only. Never put a bypass secret here.
PAYFAST_NOTIFY_ORIGIN=
